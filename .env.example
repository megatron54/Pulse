# Copiar a .env y rellenar antes de `docker compose up -d --build`

# Postgres del stack propio de Pulse
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-real

# Auth v1 de la API (ver backend/api/dependencies.py). Obligatoria si
# PULSE_ENV != dev (fail-closed por diseño). Genera una cadena aleatoria
# larga, ej: python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSE_API_KEY=

# "dev" desactiva la exigencia de PULSE_API_KEY (solo para desarrollo
# local). Cualquier otro valor (ej. "production") exige PULSE_API_KEY.
PULSE_ENV=dev

# Origen exacto del frontend, para CORS (ver backend/api/main.py)
PULSE_FRONTEND_ORIGIN=http://localhost:3000

# URL pública de la API que usará el frontend (se embebe en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Capa conversacional (Gemini free tier). Opcional: sin esta clave, el
# coach usa su plantilla determinista de respaldo (ver
# backend/coach/narrative_service.py) - la app funciona igual sin IA.
GEMINI_API_KEY=
