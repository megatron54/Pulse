# Copiar a .env y rellenar antes de `docker compose up -d --build`

# Postgres del stack propio de Pulse
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-real

# Auth v1 de la API (ver backend/api/dependencies.py). Obligatoria si
# PULSE_ENV != dev (fail-closed por diseño). Genera una cadena aleatoria
# larga, ej: python -c "import secrets; print(secrets.token_urlsafe(32))"
PULSE_API_KEY=

# "dev" desactiva la exigencia de PULSE_API_KEY (solo para desarrollo
# local). Cualquier otro valor (ej. "production") exige PULSE_API_KEY.
PULSE_ENV=dev

# Origen exacto del frontend, para CORS (ver backend/api/main.py)
PULSE_FRONTEND_ORIGIN=http://localhost:3000

# URL pública de la API que usará el frontend (se embebe en el build)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Capa conversacional (ver backend/coach/llm_factory.py). Ambas son
# opcionales: sin ninguna configurada, el coach usa su plantilla
# determinista de respaldo (backend/coach/narrative_service.py) - la
# app funciona igual sin IA.
#
# Opción preferida: Ollama local (gratis, sin cuota, sin enviar datos
# de salud a un tercero). Si se rellena OLLAMA_HOST, tiene prioridad
# sobre GEMINI_API_KEY. Requiere un servidor Ollama accesible en esa
# URL con el modelo ya descargado (`ollama pull llama3.2`).
OLLAMA_HOST=
OLLAMA_MODEL=llama3.2

# Alternativa: API gratuita de Google Gemini (el SDK `google-generativeai`
# está deprecado por Google - ver backend/coach/gemini_client.py -, se
# mantiene solo por compatibilidad con instalaciones existentes).
GEMINI_API_KEY=
